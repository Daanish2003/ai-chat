# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Encrypts users' Provider and Tool credentials at rest (ADR 0010). The newest key: it encrypts.
# Fixed in tests. Generate one with: openssl rand -base64 32
# @type=string(minLength=32)
KEY_ENCRYPTION_SECRET=if(forEnv(test), test-key-encryption-secret-not-for-production)

# The key before KEY_ENCRYPTION_SECRET, kept while rotating (ADR 0010): it still decrypts stored
# credentials but encrypts none. Leave it unset unless rotating.
# @type=string(minLength=32)
# @required=false
KEY_ENCRYPTION_SECRET_PREVIOUS=

# Shares Runs between processes (ADR 0006). Set it when more than one process serves the app, a
# zero-downtime deploy included. Unset, the app runs on the in-memory runtime.
# @type=url
# @required=false
REDIS_URL=
