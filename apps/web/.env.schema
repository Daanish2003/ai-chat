# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The public origin of the app. Not a secret: it appears in every verification link, so Varlock's
# leak check must not treat it as one (it would turn the mailbox route's responses into 500s).
# @type=url
# @sensitive=false
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Encrypts users' Provider and Tool credentials at rest (ADR 0010). The newest key: it encrypts.
# Fixed in tests. Generate one with: openssl rand -base64 32
# @type=string(minLength=32)
KEY_ENCRYPTION_SECRET=if(forEnv(test), test-key-encryption-secret-not-for-production)

# The key before KEY_ENCRYPTION_SECRET, kept while rotating (ADR 0010): it still decrypts stored
# credentials but encrypts none. Leave it unset unless rotating.
# @type=string(minLength=32)
# @required=false
KEY_ENCRYPTION_SECRET_PREVIOUS=

# Sends the auth emails (verification, and the rest as they land). In production it is Resend, so
# its key is required there and optional elsewhere.
# @type=string(minLength=1)
# @required=forEnv(production)
RESEND_API_KEY=

# The From address of every email, e.g. "AI Chat <no-reply@example.com>". Required in production.
# @type=string(minLength=1)
# @required=forEnv(production)
EMAIL_FROM=

# OAuth client ids and secrets for "Continue with GitHub" and "Continue with Google" (the callback
# is <BETTER_AUTH_URL>/api/auth/callback/<provider>). Required in production; in development the
# buttons fail until they are set.
# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
GITHUB_CLIENT_ID=

# @type=string(minLength=1)
# @required=forEnv(production)
GITHUB_CLIENT_SECRET=

# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
# @required=forEnv(production)
GOOGLE_CLIENT_SECRET=

# The app's name in emails and their subjects. Required in production. Public: it is printed in
# every email, so the leak check must not scan for it.
# @type=string(minLength=1)
# @required=forEnv(production)
# @sensitive=false
APP_NAME=

# Which sender delivers the mail. Unset: Resend in production, the console (logs the link and
# writes the HTML) elsewhere. `capture` keeps messages in memory for the end-to-end tests, behind
# the test-only mailbox route, and needs a localhost BETTER_AUTH_URL.
# @type=enum(console, resend, capture)
# @required=false
EMAIL_TRANSPORT=

# Test-only: hosts the `fetch_url` tool may read past the SSRF guard, plain HTTP included, as a
# comma-separated list of `host` or `host:port`. The end-to-end tests serve their fake page on
# localhost. It needs a localhost BETTER_AUTH_URL, so the app refuses it anywhere else.
# Not a secret: a host list, so Varlock's leak check must not scan responses for it.
# @type=string
# @required=false
# @sensitive=false
SSRF_ALLOW_HOSTS=

# The one remote MCP server users can connect to (spec #91). Set all five or none: with none, users
# see no Connections section and no MCP tools. The URL is the server's Streamable HTTP endpoint, HTTPS
# only. The key names the server in storage and in its tools ("<key>_<tool>"): letters, digits, "_"
# and "-". The OAuth client is one the Host registered with the server ahead of time (no Dynamic
# Client Registration), and its redirect URI is <BETTER_AUTH_URL>/api/chat/mcp/callback.
# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_KEY=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_NAME=

# @type=url
# @required=false
# @sensitive=false
MCP_SERVER_URL=

# @type=string(minLength=1)
# @required=false
# @sensitive=false
MCP_SERVER_OAUTH_CLIENT_ID=

# @type=string(minLength=1)
# @required=false
MCP_SERVER_OAUTH_CLIENT_SECRET=

# Shares Runs between processes (ADR 0006). Set it when more than one process serves the app, a
# zero-downtime deploy included. Unset, the app runs on the in-memory runtime.
# @type=url
# @required=false
REDIS_URL=
