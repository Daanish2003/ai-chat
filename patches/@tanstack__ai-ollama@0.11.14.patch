 /**
+* A client for one request whose fetch follows the run's abort signal, so aborting the run
+* cancels the request to Ollama. The ollama client takes no per-request signal.
+*/
+function abortableClient(client, signal) {
+	const baseFetch = client.fetch;
+	return new Ollama({
+		host: client.config.host,
+		headers: client.config.headers,
+		fetch: (input, init) => baseFetch(input, {
+			...init,
+			signal: init?.signal ? AbortSignal.any([init.signal, signal]) : signal
+		})
+	});
+}
