// Prisma owns the `public` schema: Auth.js's user for the Credentials provider. The Chat SDK's
// tables live in the `chat` schema of the same database and are migrated by the SDK (db:migrate).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}
